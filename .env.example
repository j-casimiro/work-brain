# Copy to .env. Paths may be absolute or relative to brain-server/.
BRAIN=work
VAULT_DIR=../work-vault
DB_PATH=./data/memory.db
# Used by the REST/MCP adapters (step 5). Generate any long random string.
API_TOKEN=change-me

# Jira REST access for the dashboard's "Refresh from Jira" button and `npm run jira-sync`.
# Create the token at https://id.atlassian.com/manage-profile/security/api-tokens. Restart the dashboard after editing.
JIRA_EMAIL=
JIRA_API_TOKEN=
# Optional overrides:
# JIRA_SITE=https://samurai-cmms.atlassian.net
# JIRA_JQL=project = SMS AND assignee = currentUser() ORDER BY updated DESC
# JIRA_DONE_STATUSES=Done in BRANCH,Done in PROD
# JIRA_ASSIGNEE=Jehu Casimiro
# WEB_PORT=4317
